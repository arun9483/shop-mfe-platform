# Tenant orga (MVP-3 phase 3): copy to tenants/orga.env (gitignored) and set every change-me.
# docker/tenant.sh up orga runs the stack as Compose project tenant-orga with only these settings.
TENANT_ID=orga

# Its public hosts: the shop and its own IdP, each on its own host (F4). /etc/hosts: 127.0.0.1 for both.
PUBLIC_ORIGIN=https://orga.shop.test
PUBLIC_HOST=orga.shop.test
IDP_HOST=orga-idp.test
# The Keycloak realm, and the Shell's second allowed login origin: here the tenant's own.
OIDC_REALM=orga
DEV_ORIGIN=https://orga.shop.test
# Where its nginx is published (127.0.0.1 only; the front door routes to it), its certificate, and its
# Keycloak admin console on 127.0.0.1.
TENANT_HTTPS_PORT=8443
CERTS_DIR=./certs/orga
KEYCLOAK_DEBUG_PORT=8082

ROUTER_PODS=1
SHELL_PODS=1
CATALOG_PODS=1
CART_PODS=1

# Its own Keycloak: admin, database, test users' password, operator caller. Random values.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
TEST_USER_PASSWORD=change-me
SHOP_OPS_SECRET=change-me
# Its clients' secrets at its Keycloak (replace each unit's keycloak/.env and .env copies), and its cookie
# key (openssl rand -hex 32).
SHELL_FES_SECRET=change-me
SHELL_BACKEND_SECRET=change-me
CATALOG_BACKEND_SECRET=change-me
CART_BACKEND_SECRET=change-me
AUTH_COOKIE_KEY=change-me

# New Relic: its server apps are named orga-<unit>; its browser app is its own.
NEW_RELIC_LICENSE_KEY=change-me
NEW_RELIC_USER_API_KEY=change-me
PUBLIC_NEW_RELIC_ACCOUNT_ID=
PUBLIC_NEW_RELIC_TRUST_KEY=
PUBLIC_NEW_RELIC_AGENT_ID=
PUBLIC_NEW_RELIC_APPLICATION_ID=
PUBLIC_NEW_RELIC_BROWSER_KEY=
