# The shop's identity provider, Keycloak, on its own independent host, https://${IDP_HOST} (F4: cookies
# are per host, not per port, so on the shop's host it received the shop's cookies and stored its own
# there). The nginx image fills in IDP_HOST from the environment at start. Loaded only with
# compose.sso.yaml. Login pages and OIDC endpoints only: the admin console and admin API are refused here.
# Every other host, e.g. a future tenant's orgA.shop.test, goes to the shop's server, the default.
server {
    listen 443 ssl;
    http2 on;
    server_name ${IDP_HOST};

    ssl_certificate /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;

    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;
    proxy_cache off;

    set $keycloak keycloak:8080;

    location / {
        proxy_pass http://$keycloak;
    }

    location /admin {
        return 404;
    }
}
