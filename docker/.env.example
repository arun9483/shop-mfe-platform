# The shop's public origin. Changing it needs a rebuild, because source maps are tied to this URL,
# and a matching /etc/hosts entry.
PUBLIC_ORIGIN=https://shop.test

# Pods per unit, for its FES and mock backend, and for the router. Nothing holds session state, so any
# number works. docker/deploy.sh and `docker compose up` both keep these numbers.
ROUTER_PODS=1
SHELL_PODS=1
CATALOG_PODS=1
CART_PODS=1
