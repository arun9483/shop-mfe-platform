# The shop's public origin. Changing it needs a rebuild, because source maps are tied to this URL,
# and a matching /etc/hosts entry.
PUBLIC_ORIGIN=https://shop.test

# Pods per unit, for its FES and mock backend, and for the router. Nothing holds session state, so any
# number works. docker/deploy.sh and `docker compose up` both keep these numbers.
ROUTER_PODS=1
SHELL_PODS=1
CATALOG_PODS=1
CART_PODS=1

# Single sign-on (docker/compose.sso.yaml). Keycloak's bootstrap admin, for the settings importer and the
# admin console on http://localhost:$KEYCLOAK_DEBUG_PORT/admin (127.0.0.1 only). Set random values.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_DEBUG_PORT=8081
# Password of the test users alice and bob, and the secret of the operator's caller shop-ops.
TEST_USER_PASSWORD=change-me
SHOP_OPS_SECRET=change-me
